#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif [[ -x /workspace/Kronos/.venv/bin/python ]]; then
  PY=/workspace/Kronos/.venv/bin/python
else
  PY=python3
fi
exec "$PY" "$ROOT/verification/cli.py" "$@"
